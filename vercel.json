{
    "framework": "nextjs",
    "rewrites": [
          {
                  "source": "/api/:path*",
                  "destination": "https://api.patchpilot.com/api/:path*"
          },
          {
                  "source": "/downloads/:path*",
                  "destination": "https://your-project.supabase.co/storage/v1/object/public/agent-releases/:path*"
          }
    ],
    "headers": [
          {
                  "source": "/downloads/:path*",
                  "headers": [
                            { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
                  ]
          }
    ]
}
